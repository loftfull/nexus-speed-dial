{
  "manifest_version": 3,
  "name": "Nexus Workspace Bridge (Development)",
  "version": "0.2.0",
  "description": "Development manifest for the Nexus Workspace Bridge.",
  "permissions": ["tabs"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Nexus Workspace Bridge" },
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "https://localhost/*",
      "http://127.0.0.1/*",
      "https://127.0.0.1/*"
    ]
  }
}
