{
  "name": "nexus-speed-dial",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "qa:unit": "npm run test && npm run build",
    "qa:e2e": "playwright test e2e/app-shell.spec.ts",
    "test:visual": "playwright test e2e/visual.spec.ts",
    "qa:e2e:all": "playwright test",
    "qa:reference": "node scripts/qa-reference.mjs",
    "qa:full": "npm run qa:unit && npm run qa:reference && npm run qa:e2e"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "jsdom": "^30.0.1",
    "vitest": "^5.0.1"
  }
}
